#: assets/editor/src/editor/modals/ExportModal.tsx:460
msgid "Move the two downloaded files into that folder."
msgstr "Mueve los dos archivos descargados a esa carpeta."

#: src/Deployment/Install/InstallPage.php:430
#: assets/editor/src/editor/modals/ExportModal.tsx:461

#: src/Api/Controllers/GmailDeployController.php:329
msgid "Enter the email address of a user in your Google Workspace."
msgstr ""
"Introduce la dirección de correo electrónico de un usuario de tu Google "
"Workspace."

#: src/Api/Controllers/GmailDeployController.php:336
msgid "Upload the service-account JSON key first."
msgstr "Primero sube la clave JSON de la cuenta de servicio."

#. translators: 1: email domain, 2: comma-separated allowed domains.
#: src/Api/Controllers/GmailDeployController.php:347
#, php-format
msgid ""
"%1$s is outside the allowed domains (%2$s). Add it to the allowed domains "
"and save, or test with an address in one of them."
msgstr ""
"%1$s no está entre los dominios permitidos (%2$s). Añádelo a los dominios "
"permitidos y guarda, o haz la prueba con una dirección de uno de ellos."

#: src/Api/Controllers/GmailDeployController.php:370
msgid ""
"No allowed domains are saved yet: pushes skip every user until you add your "
"Workspace domain(s)."
msgstr ""
"Aún no hay dominios permitidos guardados: los envíos omiten a todos los "
"usuarios hasta que añadas los dominios de tu Workspace."

#. translators: 1: number of addresses, 2: email address.
#: src/Api/Controllers/GmailDeployController.php:380
#, php-format
msgid "Connected. Gmail returned %1$d send-as address(es) for %2$s."
msgstr "Conectado. Gmail devolvió %1$d dirección(es) de envío para %2$s."

#: src/Api/Controllers/GmailDeployController.php:414
msgid ""
"Google Workspace is not connected yet: upload the service-account key first."
msgstr ""
"Google Workspace aún no está conectado: primero sube la clave de la cuenta "
"de servicio."

#: src/Api/Controllers/GmailDeployController.php:432
msgid "Pass user_ids or all: true."
msgstr "Indica user_ids o all: true."

#: src/Api/Controllers/GmailDeployController.php:478
msgid "Pass user_ids."
msgstr "Indica user_ids."


#: src/Deployment/Install/InstallPage.php:456
#: src/Deployment/Install/InstallPage.php:472
msgid "Press \"Copy signature\" above."
msgstr "Pulsa \"Copiar firma\" arriba."

#: src/Deployment/Install/InstallPage.php:457

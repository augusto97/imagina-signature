msgstr "Falta esta credencial o contiene espacios en blanco."

#: src/Api/Controllers/StorageController.php:285
msgid "A custom endpoint URL is required."
msgstr "Se necesita una URL de endpoint personalizada."

#: src/Api/Controllers/StorageController.php:296

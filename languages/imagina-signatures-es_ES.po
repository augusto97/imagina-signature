msgstr "Descargar texto sin formato (.txt)"

#: src/Deployment/Install/InstallPage.php:421
#: assets/editor/src/editor/modals/ExportModal.tsx:443
msgid "Copy folder path"
msgstr "Copiar la ruta de la carpeta"


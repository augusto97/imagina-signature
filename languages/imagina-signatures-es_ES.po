msgstr ""
"Introduce una URL http(s):// completa, sin parámetros de consulta ni "
"credenciales."

#: src/Api/Controllers/StorageController.php:310
msgid "Some storage settings are invalid."
msgstr "Algunos ajustes de almacenamiento no son válidos."

#: src/Api/Controllers/TeamSignaturesController.php:245
msgid "The signature changed after it was loaded. Load it again and recompile."
msgstr "La firma cambió después de cargarla. Vuelve a cargarla y recompílala."

#: src/Api/Controllers/TeamSignaturesController.php:267
msgid "The compiled signature could not be stored because of a server error."
msgstr "No se pudo guardar la firma compilada por un error del servidor."

#: src/Api/Controllers/TemplatesController.php:304
#: src/Api/Controllers/TemplatesController.php:425
#: src/Api/Controllers/TemplatesController.php:513
#: src/Services/TemplateService.php:134
#: src/Services/TemplateService.php:186
msgid "Template not found."
msgstr "No se encontró la plantilla."

#: src/Api/Controllers/TemplatesController.php:524
msgid "This template has invalid json_content; bulk apply aborted."
msgstr ""
"Esta plantilla tiene un json_content no válido; se canceló la aplicación en "
"bloque."

#: src/Api/Controllers/TemplatesController.php:557
msgid "No users matched the supplied scope."
msgstr "Ningún usuario coincide con el alcance indicado."

#: src/Api/Controllers/UploadController.php:215
msgid ""
"Uploads are disabled on this site (URL-only mode). Paste an external image "
"URL instead."
msgstr ""
"La subida de archivos está desactivada en este sitio (modo solo URL). Pega "
"la URL de una imagen externa."

#: src/Api/Controllers/UploadController.php:311
#: src/Api/Controllers/UploadController.php:423
msgid "Uploads are disabled on this site (URL-only mode)."
msgstr "La subida de archivos está desactivada en este sitio (modo solo URL)."

#: src/Api/Controllers/UploadController.php:327
msgid "No file received."
msgstr "No se recibió ningún archivo."

#: src/Api/Controllers/UploadController.php:342
msgid "File size out of range."
msgstr "El tamaño del archivo está fuera del rango permitido."

#: src/Api/Controllers/UploadController.php:445
msgid "Reported file size is missing or exceeds the configured limit."
msgstr "El tamaño de archivo indicado falta o supera el límite configurado."

#: src/Api/Controllers/UploadController.php:457
msgid "The provided storage key does not belong to your account."
msgstr "La clave de almacenamiento indicada no pertenece a tu cuenta."

#: src/Api/Controllers/UploadController.php:466
msgid ""
"This upload was not started from this account or has expired. Please upload "
"the file again."
msgstr ""
"Esta subida no se inició desde esta cuenta o ha caducado. Vuelve a subir el "
"archivo."

#: src/Api/Controllers/UploadController.php:500
msgid ""
"The uploaded file does not match what was declared when the upload started."
msgstr ""
"El archivo subido no coincide con lo que se declaró al iniciar la subida."

#: src/Api/Controllers/UploadController.php:506
msgid "The uploaded file is not a valid vCard."
msgstr "El archivo subido no es una vCard válida."

#: src/Api/Controllers/UploadController.php:512
msgid "The uploaded file exceeds the configured size limit."
msgstr "El archivo subido supera el límite de tamaño configurado."

#: src/Api/Controllers/UploadController.php:622
msgid "File size exceeds the configured limit."
msgstr "El tamaño del archivo supera el límite configurado."

#. translators: %s: storage quota, e.g. "100 MB".
#: src/Api/Controllers/UploadController.php:659
#, php-format
msgid ""
"You have reached your storage limit (%s). Delete unused images to free up "
"space."
msgstr ""
"Alcanzaste tu límite de almacenamiento (%s). Elimina las imágenes que no "
"uses para liberar espacio."

#: src/Api/Controllers/UploadController.php:677
msgid "Unsupported file type."
msgstr "Tipo de archivo no compatible."

#: src/Api/Controllers/UploadController.php:690
msgid "No object exists at the reported storage key. Was the upload completed?"
msgstr ""
"No existe ningún objeto en la clave de almacenamiento indicada. ¿Se completó "
"la subida?"

#: src/Api/Middleware/OwnershipCheck.php:103
msgid "The requested resource was not found or does not belong to you."
msgstr "El recurso solicitado no existe o no te pertenece."

#. translators: %d: number of seconds to wait before retrying.
#: src/Api/Middleware/RateLimiter.php:150
#, php-format
msgid "Too many requests. Try again in %d seconds."
msgstr "Demasiadas solicitudes. Inténtalo de nuevo en %d segundos."

#: src/Core/Activator.php:50
msgid ""
"Imagina Signatures requires PHP 7.4 or higher and WordPress 6.0 or higher."
msgstr ""
"Imagina Signatures requiere PHP 7.4 o superior y WordPress 6.0 o superior."

#: src/Core/Activator.php:54
#: src/Core/Activator.php:79
msgid "Plugin activation failed"
msgstr "Falló la activación del plugin"

#. translators: %s: error message.
#: src/Core/Activator.php:75
#, php-format
msgid ""
"Imagina Signatures could not finish activating: %s. The plugin has been "
"deactivated. Check the WordPress error log for the full stack trace."
msgstr ""
"Imagina Signatures no pudo terminar de activarse: %s. El plugin se ha "
"desactivado. Revisa el registro de errores de WordPress para ver el detalle "
"completo."

#: src/Deployment/Gmail/GmailApi.php:141
msgid "The signature HTML could not be encoded for Gmail (invalid characters)."
msgstr ""
"No se pudo codificar el HTML de la firma para Gmail (caracteres no válidos)."

#. translators: 1: user email, 2: numeric client ID, 3: OAuth scope URL.
#: src/Deployment/Gmail/GmailErrorMapper.php:78
#, php-format
msgid ""
"Google refused to act on behalf of %1$s: domain-wide delegation is not "
"granted to this service account, or not with the right scope. In the Google "
"Admin console go to Security → API controls → Domain-wide delegation and add "
"client ID %2$s with the scope %3$s (changes can take a few minutes to apply)."
msgstr ""
"Google se negó a actuar en nombre de %1$s: esta cuenta de servicio no tiene "
"la delegación de todo el dominio, o no la tiene con el ámbito correcto. En "
"la consola de administración de Google, ve a Seguridad → Controles de API → "
"Delegación de todo el dominio y añade el ID de cliente %2$s con el ámbito "
"%3$s (los cambios pueden tardar unos minutos en aplicarse)."

#: src/Deployment/Gmail/GmailErrorMapper.php:94
msgid ""
"Google does not recognise this service account: it was deleted or disabled. "
"Check it in Google Cloud → IAM & Admin → Service accounts, then upload a "
"fresh JSON key."
msgstr ""
"Google no reconoce esta cuenta de servicio: se eliminó o se inhabilitó. "
"Revísala en Google Cloud → IAM y administración → Cuentas de servicio y, "
"después, sube una clave JSON nueva."

#. translators: %s: user email.
#: src/Deployment/Gmail/GmailErrorMapper.php:109
#, php-format
msgid ""
"%s is not a user of the Google Workspace that granted the delegation. Check "
"the address (use the primary address, not an alias) and that the user "
"belongs to your domain."
msgstr ""
"%s no es un usuario del Google Workspace que concedió la delegación. Revisa "
"la dirección (usa la dirección principal, no un alias) y que el usuario "
"pertenezca a tu dominio."

#: src/Deployment/Gmail/GmailErrorMapper.php:121
msgid ""
"Google rejected the key's signature: the key was probably deleted or rotated "
"in Google Cloud. Create a new JSON key for the service account and upload it "
"again."
msgstr ""
"Google rechazó la firma criptográfica de la clave: probablemente la clave se "
"eliminó o se rotó en Google Cloud. Crea una clave JSON nueva para la cuenta "
"de servicio y vuelve a subirla."

#: src/Deployment/Gmail/GmailErrorMapper.php:132
msgid ""
"Google rejected the request's time window. This server's clock is probably "
"wrong — ask your host to sync it (NTP)."
msgstr ""
"Google rechazó el intervalo de tiempo de la solicitud. Probablemente el "
"reloj de este servidor no está en hora: pide a tu proveedor de hosting que "
"lo sincronice (NTP)."

#. translators: %d: HTTP status code.
#: src/Deployment/Gmail/GmailErrorMapper.php:145
#, php-format
msgid "Google refused to issue an access token (HTTP %d)."
msgstr "Google se negó a emitir un token de acceso (HTTP %d)."

#: src/Deployment/Gmail/GmailErrorMapper.php:207
msgid ""
"Google rejected the access token even after requesting a new one. Check that "
"domain-wide delegation is still granted to the service account."
msgstr ""
"Google rechazó el token de acceso incluso después de solicitar uno nuevo. "
"Comprueba que la cuenta de servicio sigue teniendo la delegación de todo el "
"dominio."

#: src/Deployment/Gmail/GmailErrorMapper.php:216
msgid "(your project)"
msgstr "(tu proyecto)"

#. translators: %s: Google Cloud project ID.
#: src/Deployment/Gmail/GmailErrorMapper.php:221
#, php-format
msgid ""
"The Gmail API is not enabled in the Google Cloud project %s. Open APIs & "
"Services → Library → Gmail API, click Enable, wait a few minutes and try "
"again."
msgstr ""
"La API de Gmail no está habilitada en el proyecto de Google Cloud %s. Abre "
"APIs y servicios → Biblioteca → Gmail API, haz clic en Habilitar, espera "
"unos minutos y vuelve a intentarlo."

#. translators: %s: OAuth scope URL.
#: src/Deployment/Gmail/GmailErrorMapper.php:237
#, php-format
msgid ""
"The access token does not carry the scope Gmail needs. In the Google Admin "
"console → Security → API controls → Domain-wide delegation, edit this client "
"ID so its scopes include exactly %s."
msgstr ""
"El token de acceso no incluye el ámbito que necesita Gmail. En la consola de "
"administración de Google → Seguridad → Controles de API → Delegación de todo "
"el dominio, edita este ID de cliente para que sus ámbitos incluyan "
"exactamente %s."

#. translators: %s: user email.
#: src/Deployment/Gmail/GmailErrorMapper.php:253
#, php-format
msgid ""
"Google refused to change the signature of %s (403). Gmail may be restricted "
"for this user's organisational unit."
msgstr ""
"Google se negó a cambiar la firma de %s (403). Puede que Gmail esté "
"restringido en la unidad organizativa de este usuario."

#. translators: %s: email address.
#: src/Deployment/Gmail/GmailErrorMapper.php:268
#, php-format
msgid "Gmail has no mailbox or send-as address %s for this user."
msgstr ""
"Gmail no tiene ningún buzón ni dirección de envío %s para este usuario."

#. translators: %s: user email.
#: src/Deployment/Gmail/GmailErrorMapper.php:283
#, php-format
msgid ""
"%s has no Gmail service (no Google Workspace licence, or Gmail is turned off "
"for their organisational unit)."
msgstr ""
"%s no tiene el servicio de Gmail (no tiene licencia de Google Workspace o "

{
  "schema_version": "1.1",
  "meta": {
    "created_at": "2026-11-05T00:00:00Z",
    "updated_at": "2026-11-05T00:00:00Z",
    "editor_version": "1.2.0"
  },
  "canvas": {
    "width": 560,
    "background_color": "#ffffff",
    "font_family": "Arial, sans-serif",
    "font_size": 14,
    "text_color": "#111827",
    "link_color": "#166534"
  },
  "variables": {
    "job_title": "Asesor Comercial",
    "phone": "+34 910 555 210",
    "mobile": "+34 655 210 480"
  },
  "blocks": [
    {
      "id": "i-1",
      "type": "image",
      "src": "{{company_logo}}",
      "alt": "{{company_name}}",
      "width": 112,
      "align": "left",
      "link": "{{company_website}}",
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 12,
        "left": 0
      }
    },
    {
      "id": "h-2",
      "type": "heading",
      "content": "{{wp_display_name}}",
      "content_html": "<p>{{wp_display_name}}</p>",
      "style": {
        "font_weight": 700,
        "line_height": 1.2,
        "text_align": "left",
        "font_size": 18,
        "color": "#111827"
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 2,
        "left": 0
      }
    },
    {
      "id": "t-3",
      "type": "text",
      "content": "{{job_title}} · {{company_name}}",
      "style": {
        "line_height": 1.4,
        "text_align": "left",
        "font_size": 13,
        "color": "#4b5563"
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 10,
        "left": 0
      }
    },
    {
      "id": "row-10",
      "type": "container",
      "columns": [
        {
          "id": "col-9",
          "width": 100,
          "children": [
            {
              "id": "t-4",
              "type": "text",
              "content": "<strong>¿Hablamos?</strong> Te respondo por WhatsApp en minutos.",
              "style": {
                "line_height": 1.4,
                "text_align": "left",
                "font_size": 13,
                "color": "#14532d"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 6,
                "left": 0
              }
            },
            {
              "id": "c-5",
              "type": "contact_row",
              "items": [
                {
                  "id": "ci-6",
                  "type": "whatsapp",
                  "value": "{{mobile}}"
                },
                {
                  "id": "ci-7",
                  "type": "phone",
                  "value": "{{phone}}"
                },
                {
                  "id": "ci-8",
                  "type": "email",
                  "value": "{{wp_email}}"
                }
              ],
              "layout": "inline",
              "separator": "    ",
              "show_icons": true,
              "icon_shape": "circle",
              "icon_tone": "brand",
              "icon_size": 16,
              "label_mode": "none",
              "row_gap": 4,
              "style": {
                "font_size": 13,
                "font_weight": 400,
                "color": "#14532d",
                "text_align": "left",
                "line_height": 1.4
              },
              "link_color": "#14532d",
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            }
          ],
          "box": {
            "background_color": "#f0fdf4",
            "border_left": {
              "width": 3,
              "style": "solid",
              "color": "#16a34a"
            },
            "border_radius": 8,
            "padding": {
              "top": 12,
              "right": 16,
              "bottom": 12,
              "left": 16
            }
          }
        }
      ],
      "gap": 0
    }
  ]
}

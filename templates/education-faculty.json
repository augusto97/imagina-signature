{
  "schema_version": "1.1",
  "meta": {
    "created_at": "2026-11-05T00:00:00Z",
    "updated_at": "2026-11-05T00:00:00Z",
    "editor_version": "1.2.0"
  },
  "canvas": {
    "width": 560,
    "background_color": "#ffffff",
    "font_family": "Georgia, serif",
    "font_size": 14,
    "text_color": "#1e3a8a",
    "link_color": "#1e40af"
  },
  "variables": {
    "job_title": "Profesora Titular",
    "department": "Facultad de Ciencias de la Comunicación",
    "phone": "+34 910 555 210",
    "address_line": "Despacho 2.14 · Campus Norte"
  },
  "blocks": [
    {
      "id": "row-11",
      "type": "container",
      "columns": [
        {
          "id": "col-2",
          "width": 28,
          "children": [
            {
              "id": "i-1",
              "type": "image",
              "src": "{{company_logo}}",
              "alt": "{{company_name}}",
              "width": 112,
              "align": "center",
              "link": "{{company_website}}",
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            }
          ],
          "valign": "middle",
          "box": {
            "align": "center"
          }
        },
        {
          "id": "col-10",
          "width": 72,
          "children": [
            {
              "id": "h-3",
              "type": "heading",
              "content": "{{wp_display_name}}",
              "content_html": "<p>{{wp_display_name}}</p>",
              "style": {
                "font_weight": 700,
                "line_height": 1.2,
                "text_align": "left",
                "font_size": 19,
                "color": "#1e3a8a"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 2,
                "left": 0
              }
            },
            {
              "id": "t-4",
              "type": "text",
              "content": "{{job_title}}",
              "style": {
                "line_height": 1.4,
                "text_align": "left",
                "font_size": 14,
                "color": "#374151",
                "font_style": "italic"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 2,
                "left": 0
              }
            },
            {
              "id": "t-5",
              "type": "text",
              "content": "{{department}} · {{company_name}}",
              "style": {
                "line_height": 1.4,
                "text_align": "left",
                "font_size": 12,
                "color": "#4b5563"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 8,
                "left": 0
              }
            },
            {
              "id": "c-6",
              "type": "contact_row",
              "items": [
                {
                  "id": "ci-7",
                  "type": "phone",
                  "value": "{{phone}}"
                },
                {
                  "id": "ci-8",
                  "type": "email",
                  "value": "{{wp_email}}"
                },
                {
                  "id": "ci-9",
                  "type": "address",
                  "value": "{{address_line}}"
                }
              ],
              "layout": "stacked",
              "separator": "  |  ",
              "show_icons": true,
              "icon_shape": "plain",
              "icon_tone": "gray",
              "icon_size": 13,
              "label_mode": "none",
              "row_gap": 3,
              "style": {
                "font_size": 12,
                "font_weight": 400,
                "color": "#374151",
                "text_align": "left",
                "line_height": 1.4,
                "font_family": "Arial, sans-serif"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            }
          ],
          "valign": "middle"
        }
      ],
      "gap": 32,
      "divider": {
        "width": 2,
        "style": "solid",
        "color": "#1e3a8a"
      }
    }
  ]
}

{
  "schema_version": "1.1",
  "meta": {
    "created_at": "2026-11-05T00:00:00Z",
    "updated_at": "2026-11-05T00:00:00Z",
    "editor_version": "1.2.0"
  },
  "canvas": {
    "width": 560,
    "background_color": "#ffffff",
    "font_family": "Arial, sans-serif",
    "font_size": 14,
    "text_color": "#0f172a",
    "link_color": "#0369a1"
  },
  "variables": {
    "job_title": "Product Manager",
    "phone": "+34 910 555 210",
    "mobile": "+34 655 210 480",
    "photo_url": "{{imgsig_assets_url}}/templates/avatar-1.png",
    "linkedin_url": "https://www.linkedin.com/in/tu-perfil"
  },
  "blocks": [
    {
      "id": "row-16",
      "type": "container",
      "columns": [
        {
          "id": "col-4",
          "width": 40,
          "children": [
            {
              "id": "a-1",
              "type": "avatar",
              "src": "{{photo_url}}",
              "alt": "{{wp_display_name}}",
              "size": 84,
              "shape": "circle",
              "align": "center",
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 8,
                "left": 0
              }
            },
            {
              "id": "h-2",
              "type": "heading",
              "content": "{{wp_display_name}}",
              "content_html": "<p>{{wp_display_name}}</p>",
              "style": {
                "font_weight": 700,
                "line_height": 1.2,
                "text_align": "center",
                "font_size": 16,
                "color": "#0f172a"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 2,
                "left": 0
              }
            },
            {
              "id": "t-3",
              "type": "text",
              "content": "{{job_title}}",
              "style": {
                "line_height": 1.4,
                "text_align": "center",
                "font_size": 12,
                "color": "#0369a1"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 2,
                "left": 0
              }
            }
          ],
          "valign": "middle",
          "box": {
            "align": "center"
          }
        },
        {
          "id": "col-15",
          "width": 60,
          "children": [
            {
              "id": "t-5",
              "type": "text",
              "content": "{{company_name}}",
              "style": {
                "line_height": 1.4,
                "text_align": "left",
                "font_size": 11,
                "font_weight": 700,
                "color": "#475569",
                "letter_spacing": 1.5,
                "text_transform": "uppercase"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 8,
                "left": 0
              }
            },
            {
              "id": "c-6",
              "type": "contact_row",
              "items": [
                {
                  "id": "ci-7",
                  "type": "email",
                  "value": "{{wp_email}}"
                },
                {
                  "id": "ci-8",
                  "type": "phone",
                  "value": "{{phone}}"
                },
                {
                  "id": "ci-9",
                  "type": "mobile",
                  "value": "{{mobile}}"
                },
                {
                  "id": "ci-10",
                  "type": "website",
                  "value": "{{company_website}}"
                }
              ],
              "layout": "stacked",
              "separator": "  |  ",
              "show_icons": true,
              "icon_shape": "circle",
              "icon_tone": "brand",
              "icon_size": 16,
              "label_mode": "none",
              "row_gap": 5,
              "style": {
                "font_size": 12,
                "font_weight": 400,
                "color": "#1e293b",
                "text_align": "left",
                "line_height": 1.4
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            },
            {
              "id": "s-11",
              "type": "social_icons",
              "items": [
                {
                  "id": "sn-12",
                  "network": "linkedin",
                  "url": "{{linkedin_url}}"
                },
                {
                  "id": "sn-13",
                  "network": "x",
                  "url": "{{company_x}}"
                },
                {
                  "id": "sn-14",
                  "network": "instagram",
                  "url": "{{company_instagram}}"
                }
              ],
              "shape": "circle",
              "tone": "brand",
              "size": 22,
              "spacing": 6,
              "align": "left",
              "padding": {
                "top": 12,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            }
          ],
          "valign": "middle"
        }
      ],
      "gap": 28,
      "divider": {
        "width": 1,
        "style": "solid",
        "color": "#e2e8f0"
      }
    }
  ]
}

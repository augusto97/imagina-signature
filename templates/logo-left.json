{
  "schema_version": "1.1",
  "meta": {
    "created_at": "2026-11-05T00:00:00Z",
    "updated_at": "2026-11-05T00:00:00Z",
    "editor_version": "1.2.0"
  },
  "canvas": {
    "width": 560,
    "background_color": "#ffffff",
    "font_family": "Arial, sans-serif",
    "font_size": 14,
    "text_color": "#0f172a",
    "link_color": "#1d4ed8"
  },
  "variables": {
    "job_title": "Directora de Marketing",
    "phone": "+34 910 555 210"
  },
  "blocks": [
    {
      "id": "row-13",
      "type": "container",
      "columns": [
        {
          "id": "col-2",
          "width": 22,
          "children": [
            {
              "id": "i-1",
              "type": "image",
              "src": "{{company_logo}}",
              "alt": "{{company_name}}",
              "width": 84,
              "align": "center",
              "link": "{{company_website}}",
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            }
          ],
          "valign": "middle",
          "box": {
            "background_color": "#f1f5f9",
            "border_radius": 10,
            "padding": {
              "top": 14,
              "right": 8,
              "bottom": 14,
              "left": 8
            },
            "align": "center"
          }
        },
        {
          "id": "col-12",
          "width": 78,
          "children": [
            {
              "id": "h-3",
              "type": "heading",
              "content": "{{wp_display_name}}",
              "content_html": "<p>{{wp_display_name}}</p>",
              "style": {
                "font_weight": 700,
                "line_height": 1.2,
                "text_align": "left",
                "font_size": 18,
                "color": "#0f172a"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 2,
                "left": 0
              }
            },
            {
              "id": "t-4",
              "type": "text",
              "content": "{{job_title}} · {{company_name}}",
              "style": {
                "line_height": 1.4,
                "text_align": "left",
                "font_size": 13,
                "color": "#475569"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 8,
                "left": 0
              }
            },
            {
              "id": "c-5",
              "type": "contact_row",
              "items": [
                {
                  "id": "ci-6",
                  "type": "email",
                  "value": "{{wp_email}}"
                },
                {
                  "id": "ci-7",
                  "type": "phone",
                  "value": "{{phone}}"
                }
              ],
              "layout": "inline",
              "separator": "    ",
              "show_icons": true,
              "icon_shape": "rounded",
              "icon_tone": "brand",
              "icon_size": 15,
              "label_mode": "none",
              "row_gap": 4,
              "style": {
                "font_size": 12,
                "font_weight": 400,
                "color": "#1e293b",
                "text_align": "left",
                "line_height": 1.4
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            },
            {
              "id": "s-8",
              "type": "social_icons",
              "items": [
                {
                  "id": "sn-9",
                  "network": "linkedin",
                  "url": "{{company_linkedin}}"
                },
                {
                  "id": "sn-10",
                  "network": "x",
                  "url": "{{company_x}}"
                },
                {
                  "id": "sn-11",
                  "network": "instagram",
                  "url": "{{company_instagram}}"
                }
              ],
              "shape": "circle",
              "tone": "dark",
              "size": 20,
              "spacing": 6,
              "align": "left",
              "padding": {
                "top": 10,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            }
          ],
          "valign": "middle"
        }
      ],
      "gap": 20
    }
  ]
}

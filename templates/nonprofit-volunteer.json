                    },
                    {
                      "id": "t-8",
                      "type": "text",
                      "content": "<a href=\"{{website_url}}\"><strong>Hazte voluntario →</strong></a>",
                      "style": {
                        "line_height": 1.4,
                        "text_align": "left",
                        "font_size": 13,
                        "color": "#0f766e"
                      },
                      "padding": {
                        "top": 8,

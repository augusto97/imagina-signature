                        "font_weight": 700,
                        "line_height": 1.2,
                        "text_align": "left",
                        "font_size": 17,
                        "color": "#1f2937"
                      },
                      "padding": {
                        "top": 0,
                        "right": 0,
                        "bottom": 2,
                        "left": 0

{
  "schema_version": "1.1",
  "meta": {
    "created_at": "2026-11-05T00:00:00Z",
    "updated_at": "2026-11-05T00:00:00Z",
    "editor_version": "1.2.0"
  },
  "canvas": {
    "width": 560,
    "background_color": "#ffffff",
    "font_family": "Arial, sans-serif",
    "font_size": 14,
    "text_color": "#111827",
    "link_color": "#1d4ed8"
  },
  "variables": {
    "job_title": "Directora de Marketing",
    "phone": "+34 910 555 210",
    "mobile": "+34 655 210 480",
    "address_line": "Paseo de la Castellana 89, 28046 Madrid"
  },
  "blocks": [
    {
      "id": "row-16",
      "type": "container",
      "columns": [
        {
          "id": "col-2",
          "width": 32,
          "children": [
            {
              "id": "i-1",
              "type": "image",
              "src": "{{company_logo}}",
              "alt": "{{company_name}}",
              "width": 128,
              "align": "center",
              "link": "{{company_website}}",
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            }
          ],
          "valign": "middle",
          "box": {
            "align": "center"
          }
        },
        {
          "id": "col-15",
          "width": 68,
          "children": [
            {
              "id": "h-3",
              "type": "heading",
              "content": "{{wp_display_name}}",
              "content_html": "<p>{{wp_display_name}}</p>",
              "style": {
                "font_weight": 700,
                "line_height": 1.2,
                "text_align": "left",
                "font_size": 18,
                "color": "#111827"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 2,
                "left": 0
              }
            },
            {
              "id": "t-4",
              "type": "text",
              "content": "{{job_title}} · {{company_name}}",
              "style": {
                "line_height": 1.4,
                "text_align": "left",
                "font_size": 13,
                "color": "#6b7280"
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 8,
                "left": 0
              }
            },
            {
              "id": "c-5",
              "type": "contact_row",
              "items": [
                {
                  "id": "ci-6",
                  "type": "phone",
                  "value": "{{phone}}"
                },
                {
                  "id": "ci-7",
                  "type": "mobile",
                  "value": "{{mobile}}"
                },
                {
                  "id": "ci-8",
                  "type": "email",
                  "value": "{{wp_email}}"
                },
                {
                  "id": "ci-9",
                  "type": "address",
                  "value": "{{address_line}}"
                }
              ],
              "layout": "stacked",
              "separator": "  |  ",
              "show_icons": true,
              "icon_shape": "plain",
              "icon_tone": "dark",
              "icon_size": 13,
              "label_mode": "none",
              "row_gap": 3,
              "style": {
                "font_size": 12,
                "font_weight": 400,
                "color": "#374151",
                "text_align": "left",
                "line_height": 1.4
              },
              "padding": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            },
            {
              "id": "s-10",
              "type": "social_icons",
              "items": [
                {
                  "id": "sn-11",
                  "network": "linkedin",
                  "url": "{{company_linkedin}}"
                },
                {
                  "id": "sn-12",
                  "network": "facebook",
                  "url": "{{company_facebook}}"
                },
                {
                  "id": "sn-13",
                  "network": "instagram",
                  "url": "{{company_instagram}}"
                },
                {
                  "id": "sn-14",
                  "network": "youtube",
                  "url": "{{company_youtube}}"
                }
              ],
              "shape": "rounded",
              "tone": "brand",
              "size": 20,
              "spacing": 6,
              "align": "left",
              "padding": {
                "top": 10,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            }
          ],
          "valign": "middle"
        }
      ],
      "gap": 36,
      "divider": {
        "width": 1,
        "style": "solid",
        "color": "#d1d5db"
      }
    }
  ]
}

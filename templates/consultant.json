{
  "schema_version": "1.1",
  "meta": {
    "created_at": "2026-11-05T00:00:00Z",
    "updated_at": "2026-11-05T00:00:00Z",
    "editor_version": "1.2.0"
  },
  "canvas": {
    "width": 560,
    "background_color": "#ffffff",
    "font_family": "Arial, sans-serif",
    "font_size": 14,
    "text_color": "#1f2937",
    "link_color": "#0a66c2"
  },
  "variables": {
    "job_title": "Consultora de Estrategia · MBA, PMP",
    "mobile": "+34 655 210 480",
    "linkedin_url": "https://www.linkedin.com/in/tu-perfil"
  },
  "blocks": [
    {
      "id": "h-1",
      "type": "heading",
      "content": "{{wp_display_name}}",
      "content_html": "<p>{{wp_display_name}}</p>",
      "style": {
        "font_weight": 700,
        "line_height": 1.2,
        "text_align": "left",
        "font_size": 19,
        "color": "#1f2937"
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 2,
        "left": 0
      }
    },
    {
      "id": "t-2",
      "type": "text",
      "content": "{{job_title}}",
      "style": {
        "line_height": 1.4,
        "text_align": "left",
        "font_size": 13,
        "font_weight": 700,
        "color": "#0a66c2"
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 2,
        "left": 0
      }
    },
    {
      "id": "t-3",
      "type": "text",
      "content": "{{company_name}}",
      "style": {
        "line_height": 1.4,
        "text_align": "left",
        "font_size": 13,
        "color": "#4b5563"
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 8,
        "left": 0
      }
    },
    {
      "id": "c-4",
      "type": "contact_row",
      "items": [
        {
          "id": "ci-5",
          "type": "mobile",
          "value": "{{mobile}}"
        },
        {
          "id": "ci-6",
          "type": "email",
          "value": "{{wp_email}}"
        }
      ],
      "layout": "inline",
      "separator": "    ",
      "show_icons": true,
      "icon_shape": "plain",
      "icon_tone": "gray",
      "icon_size": 13,
      "label_mode": "none",
      "row_gap": 4,
      "style": {
        "font_size": 12,
        "font_weight": 400,
        "color": "#374151",
        "text_align": "left",
        "line_height": 1.4
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 0,
        "left": 0
      }
    },
    {
      "id": "b-7",
      "type": "button_cta",
      "label": "Conecta en LinkedIn",
      "href": "{{linkedin_url}}",
      "background_color": "#0a66c2",
      "text_color": "#ffffff",
      "border_radius": 4,
      "preset": "solid",
      "padding_x": 16,
      "padding_y": 8,
      "align": "left",
      "style": {
        "font_size": 12,
        "font_weight": 600
      },
      "padding": {
        "top": 12,
        "right": 0,
        "bottom": 0,
        "left": 0
      }
    }
  ]
}

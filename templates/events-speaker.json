      "style": {
        "font_size": 12,
        "font_weight": 400,
        "color": "#374151",
        "text_align": "left",
        "line_height": 1.4
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 0,
        "left": 0
      }
    },
    {
      "id": "row-14",
      "type": "container",
      "columns": [
        {
          "id": "col-13",
          "width": 100,
          "children": [
            {
              "id": "row-12",
              "type": "container",
              "columns": [
                {
                  "id": "col-9",

    "mobile": "+34 655 210 480",
    "website_url": "https://www.tuempresa.com/eventos",
    "linkedin_url": "https://www.linkedin.com/in/tu-perfil"
  },
  "blocks": [
    {
      "id": "h-1",
      "type": "heading",
      "content": "{{wp_display_name}}",
      "content_html": "<p>{{wp_display_name}}</p>",
      "style": {
        "font_weight": 700,
        "line_height": 1.2,
        "text_align": "left",
        "font_size": 19,
        "color": "#1f2937"
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 2,
        "left": 0
      }
    },
    {
      "id": "t-2",
      "type": "text",
      "content": "{{job_title}} · <strong>{{company_name}}</strong>",
      "style": {
        "line_height": 1.4,
        "text_align": "left",
        "font_size": 13,
        "color": "#4b5563"
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 8,
        "left": 0

{
  "schema_version": "1.1",
  "meta": {
    "created_at": "2026-11-05T00:00:00Z",
    "updated_at": "2026-11-05T00:00:00Z",
    "editor_version": "1.2.0"
  },
  "canvas": {
    "width": 560,
    "background_color": "#ffffff",
    "font_family": "Georgia, serif",
    "font_size": 14,
    "text_color": "#1c1917",
    "link_color": "#44403c"
  },
  "variables": {
    "job_title": "Consejera Delegada",
    "phone": "+34 910 555 210"
  },
  "blocks": [
    {
      "id": "h-1",
      "type": "heading",
      "content": "{{wp_display_name}}",
      "content_html": "<p>{{wp_display_name}}</p>",
      "style": {
        "font_weight": 400,
        "line_height": 1.2,
        "text_align": "left",
        "font_size": 23,
        "color": "#1c1917",
        "letter_spacing": 0.3
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 2,
        "left": 0
      }
    },
    {
      "id": "t-2",
      "type": "text",
      "content": "{{job_title}}",
      "style": {
        "line_height": 1.4,
        "text_align": "left",
        "font_family": "Arial, sans-serif",
        "font_size": 11,
        "color": "#57534e",
        "letter_spacing": 2,
        "text_transform": "uppercase"
      },
      "padding": {
        "top": 4,
        "right": 0,
        "bottom": 0,
        "left": 0
      }
    },
    {
      "id": "dv-3",
      "type": "divider",
      "border": {
        "width": 1,
        "style": "solid",
        "color": "#a16207"
      },
      "width_percent": 100,
      "width_unit": "px",
      "align": "left",
      "width_px": 36,
      "padding": {
        "top": 12,
        "right": 0,
        "bottom": 12,
        "left": 0
      }
    },
    {
      "id": "t-4",
      "type": "text",
      "content": "{{company_name}}",
      "style": {
        "line_height": 1.4,
        "text_align": "left",
        "font_size": 14,
        "color": "#44403c",
        "font_style": "italic"
      },
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 4,
        "left": 0
      }
    },
    {
      "id": "c-5",
      "type": "contact_row",
      "items": [
        {
          "id": "ci-6",
          "type": "phone",
          "value": "{{phone}}"
        },
        {
          "id": "ci-7",
          "type": "email",
          "value": "{{wp_email}}"
        },
        {
          "id": "ci-8",
          "type": "website",
          "value": "{{company_website}}"
        }
      ],
      "layout": "inline",
      "separator": " · ",
      "show_icons": false,
      "icon_shape": "plain",
      "icon_tone": "gray",
      "icon_size": 14,
      "label_mode": "none",
      "row_gap": 4,
      "style": {
        "font_size": 12,
        "font_weight": 400,
        "color": "#57534e",
        "text_align": "left",
        "line_height": 1.4,
        "font_family": "Arial, sans-serif"
      },
      "link_color": "#57534e",
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 0,
        "left": 0
      }
    }
  ]
}
